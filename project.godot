; Engine configuration file.
config_version=5

[application]

config/name="HUSH"
config/description="A girl, a brass bell, and a town that went silent."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

GameState="*res://scripts/game_state.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=120
2d/default_gravity=2200.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.07, 1)
textures/canvas_textures/default_texture_filter=1

[threading]
worker_pool/max_threads=2
